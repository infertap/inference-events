{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infertap.ai/schemas/inference-events/records.schema.json",
  "title": "Inference event records",
  "description": "Structural wire contract. Stream obligations are defined in spec/kv-cache-v2.md. Unknown fields are preserved for forward compatibility.",
  "oneOf": [
    {
      "$ref": "#/$defs/agent_start"
    },
    {
      "$ref": "#/$defs/agent_stop"
    },
    {
      "$ref": "#/$defs/clear"
    },
    {
      "$ref": "#/$defs/evict"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/holder_reset"
    },
    {
      "$ref": "#/$defs/identity_refused"
    },
    {
      "$ref": "#/$defs/segment_open"
    },
    {
      "$ref": "#/$defs/segment_recovered"
    },
    {
      "$ref": "#/$defs/segments_dropped"
    },
    {
      "$ref": "#/$defs/store"
    }
  ],
  "$defs": {
    "Endpoint": {
      "type": "object",
      "properties": {
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required"
        },
        "endpoint": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required"
        },
        "last_msg_at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "optional"
        },
        "msgs_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required"
        },
        "publisher_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional"
        },
        "source": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required"
        },
        "topic": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional"
        }
      },
      "required": [
        "dropped",
        "endpoint",
        "msgs_seen",
        "source"
      ],
      "additionalProperties": true
    },
    "agent_start": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "agent_start"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "producer clock"
        },
        "agent_version": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "producer version"
        },
        "egress": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "one of `pseudonymized` or `raw`. `raw` means identities are emitted unprotected and \u00a73's key-space rules do not apply"
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "subscriptions configured"
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "largest inbound engine message accepted"
        },
        "canary": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "conditional",
          "description": "present when identities are keyed (\u00a73.4)"
        },
        "reuse_reporting": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "as `heartbeat`"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "agent_version",
        "egress",
        "endpoint_count",
        "max_payload_bytes"
      ],
      "additionalProperties": true,
      "x-section": "2.4",
      "allOf": [
        {
          "if": {
            "properties": {
              "egress": {
                "const": "pseudonymized"
              }
            },
            "required": [
              "egress"
            ]
          },
          "then": {
            "required": [
              "canary"
            ]
          }
        }
      ]
    },
    "agent_stop": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "agent_stop"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "producer clock"
        },
        "reason": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "why the run ended"
        },
        "msgs_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "oversized": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "unknown_types": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "events_ingested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "content_unresolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "content_bridge_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "content_bridge_evicted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "publisher_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "reuse_reporting": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "as `heartbeat`"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "x-column-type": "list<struct>",
          "x-presence": "required",
          "description": "as `heartbeat`"
        },
        "canary": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "conditional",
          "description": "present when identities are keyed (\u00a73.4)"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "reason",
        "msgs_seen",
        "dropped",
        "oversized",
        "unknown_types",
        "events_ingested",
        "content_unresolved",
        "content_bridge_entries",
        "content_bridge_evicted",
        "publisher_restarts",
        "endpoints"
      ],
      "additionalProperties": true,
      "x-section": "2.4"
    },
    "clear": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "clear"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "engine clock"
        },
        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "the engine process holding this cache, named by the operator (\u00a73.2)"
        },
        "scope": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "what was cleared, for example `all`"
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "the data parallel worker the clear applies to; **absent means the wire declared none and the clear is global across workers** (\u00a73.2 and the note below)"
        },
        "group_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "as `dp_rank`, for cache groups"
        },
        "tier": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "storage tier the clear applied to; **absent means the clear is global across tiers**"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "as `store`"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "instance_id",
        "scope"
      ],
      "additionalProperties": true,
      "x-section": "2.3"
    },
    "evict": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "evict"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "engine clock"
        },
        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "the engine process whose cache the block left (\u00a73.2)"
        },
        "block_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "engine-local identity (\u00a73.1), the same value its `store` carried"
        },
        "tier": {
          "type": [
            "string",
            "null"
          ],
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "storage tier the block left. A block offloaded to another tier is evicted from the one it left"
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "the data parallel worker within that instance (\u00a73.2)"
        },
        "group_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "the cache group within that worker (\u00a73.2)"
        },
        "content_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "portable identity (\u00a73.1), resolved by the producer as described below"
        },
        "locality": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "`LOCAL` or `REMOTE`, relative to the publishing holder"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "transport sequence of the message that carried this event"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "Pseudonymization key epoch."
        },
        "backend_id": {
          "type": "string",
          "description": "Optional engine-emitted backend identity, scoped to publisher incarnation, rank, group and tier. Pseudonymized at egress.",
          "x-column-type": "utf8",
          "x-presence": "optional"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "instance_id",
        "block_id"
      ],
      "additionalProperties": true,
      "x-section": "2.3"
    },
    "heartbeat": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "heartbeat"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "producer clock"
        },
        "msgs_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "inbound messages observed on this subscription"
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "inbound messages known lost on this subscription"
        },
        "oversized": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "inbound messages refused for size"
        },
        "unknown_types": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "inbound messages of unmodelled type"
        },
        "events_ingested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "events that reached the record model"
        },
        "content_unresolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "records emitted with no `content_id`, one per omission (\u00a73.1)"
        },
        "content_bridge_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "identity-derivation state size (the producer's view of the resident set)"
        },
        "content_bridge_evicted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "identity promises refused at the declared capacity \u2014 nonzero means some evicts will not resolve, each window also declared via `identity_refused`"
        },
        "publisher_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "sequence regressions observed on this subscription; the envelope's `publisher_restarts` is their sum, and `holder_reset` (\u00a72.3) is the record a reader acts on"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "x-column-type": "list<struct>",
          "x-presence": "required",
          "description": "per-subscription statistics, below"
        },
        "canary": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "conditional",
          "description": "present when identities are keyed (\u00a73.4)"
        },
        "reuse_reporting": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "`none` \\| `labelled` \\| `unlabelled` \u2014 whether this producer's engine announces cache reuse as a `store`, and whether it can be told apart (\u00a72.3)"
        },
        "noraw_scanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "values checked by the producer's egress guard"
        },
        "rss_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "producer resident memory"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "msgs_seen",
        "dropped",
        "oversized",
        "unknown_types",
        "events_ingested",
        "content_unresolved",
        "content_bridge_entries",
        "content_bridge_evicted",
        "publisher_restarts",
        "endpoints"
      ],
      "additionalProperties": true,
      "x-section": "2.4"
    },
    "holder_reset": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "holder_reset"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "producer clock at detection (\u00a72.6)"
        },
        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "the engine the regressed source observes (\u00a73.2)"
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "the worker whose publisher regressed; **absent means the source hosts every rank and the reset is global across workers**"
        },
        "group_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "as `dp_rank`; a producer deriving the reset from a sequence regression MUST omit it, because a process restart is never group-scoped"
        },
        "boundary_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "**engine clock**: the earliest event timestamp in the regressed message \u2014 the instant the reset is ordered at"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "the regressed sequence number, as the wire carried it"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "instance_id",
        "boundary_ms"
      ],
      "additionalProperties": true,
      "x-section": "2.3"
    },
    "identity_refused": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "identity_refused"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "producer clock"
        },
        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "the affected instance (\u00a73.2)"
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "the affected worker"
        },
        "group_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "the affected cache group"
        },
        "refused": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "stores denied an identity in the window"
        },
        "window_start_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "**engine clock**: first refused store"
        },
        "window_end_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "**engine clock**: last refused store"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "instance_id",
        "dp_rank",
        "group_idx",
        "refused",
        "window_start_ms",
        "window_end_ms"
      ],
      "additionalProperties": true,
      "x-section": "2.4"
    },
    "segment_open": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "segment_open"
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "producer clock"
        },
        "incarnation": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "identifies one run of one producer (\u00a74.2)"
        },
        "segment_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "position in that incarnation's sequence, from zero"
        },
        "contract_version": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "the version of this contract the segment conforms to (\u00a76.1)"
        },
        "workload_class": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "what this producer's traffic is FOR, in the operator's vocabulary (\u00a72.7). Since 1.2"
        },
        "heartbeat_secs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "declared heartbeat interval (\u00a75.8). Since 1.3"
        },
        "max_segment_secs": {
